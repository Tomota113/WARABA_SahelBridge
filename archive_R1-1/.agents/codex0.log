index 0000000000000000000000000000000000000000..b4cb6a3b5fe6e79d91459c34579e0e0900a2252f
--- /dev/null
+++ b/plans/generer_plans.mjs
@@ -0,0 +1,253 @@
+import { mkdir, writeFile } from 'node:fs/promises';
+import { g, span, mid, fmt, signed, volumes, jeux } from './geometrie.mjs';
+
+// Constantes ci-dessous : exclusivement projection, style et mise en page (mm papier).
+const S = 1 / 2.5;
+const C = { '01':'#dfe5ec', '02':'#3b4654', '03':'#c9a978', '04':'#9fb8d6', '05':'#b9c7b0', '06':'#b9c7b0', '07':'#2f2f2f', '08':'url(#hachures08)', '09':'#d0352b', '10':'none' };
+const esc = x => String(x).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');
+const n = x => Number(x.toFixed(4));
+const attrs = a => Object.entries(a).filter(([,v]) => v !== undefined).map(([k,v]) => ` ${k}="${esc(v)}"`).join('');
+const el = (tag,a={},body='') => `<${tag}${attrs(a)}>${body}</${tag}>`;
+const line = (x1,y1,x2,y2,cls='fin',extra={}) => el('line',{x1:n(x1),y1:n(y1),x2:n(x2),y2:n(y2),class:cls,...extra});
+const text = (x,y,t,cls='texte',extra={}) => el('text',{x:n(x),y:n(y),class:cls,...extra},esc(t));
+const path = (points, extra={}) => el('path',{d:points.map((p,i)=>`${i?'L':'M'}${n(p[0])},${n(p[1])}`).join(' ')+' Z',...extra});
+const rect = (x,y,w,h,rep,extra={}) => el('rect',{x:n(x),y:n(y),width:n(w),height:n(h),fill:C[rep],class:'contour',...extra});
+const circle = (x,y,r,extra={}) => el('circle',{cx:n(x),cy:n(y),r:n(r),class:'contour',...extra});
+const defs = `<defs>
+  <pattern id="hachures08" patternUnits="userSpaceOnUse" width="${3/S}" height="${3/S}" patternTransform="rotate(45)"><rect width="${3/S}" height="${3/S}" fill="#fff4f1"/><line x1="0" y1="0" x2="0" y2="${3/S}" stroke="#c0392b" stroke-width="${.25/S}"/></pattern>
+  <marker id="fleche" markerUnits="userSpaceOnUse" markerWidth="${2/S}" markerHeight="${2/S}" refX="0" refY="0" viewBox="-2 -1 2 2" orient="auto-start-reverse"><path d="M0 0 L-2 -0.7 L-2 0.7 Z" fill="#26303a"/></marker>
+  <style>
+    text{font-family:Inter,'DejaVu Sans',Arial,sans-serif;fill:#202833}
+    .contour{stroke:#27313a;stroke-width:${.5/S};stroke-linejoin:round}
+    .fin,.rappel{stroke:#46515b;stroke-width:${.25/S};fill:none}
+    .rappel{stroke:#626c75}.axe{stroke:#5a6876;stroke-width:${.18/S};stroke-dasharray:${[5,1,1,1].map(x=>x/S).join(' ')};fill:none}
+    .cache{stroke:#485563;stroke-width:${.25/S};stroke-dasharray:${2/S} ${1.2/S};fill:none}
+    .fantome{stroke:#d0352b;stroke-width:${.25/S};stroke-dasharray:${1/S} ${1/S};fill:none}
+    .texte{font-size:${2.3/S}px;text-anchor:middle;dominant-baseline:middle}
+    .petit{font-size:${2/S}px;text-anchor:middle;dominant-baseline:middle}
+    .cote{font-size:${2.3/S}px;text-anchor:middle;dominant-baseline:middle;paint-order:stroke;stroke:white;stroke-width:${1.2/S};stroke-linejoin:round}
+    .repere{font-size:${2.5/S}px;font-weight:700;text-anchor:middle;dominant-baseline:middle}
+    .papier{font-size:2.3px}.titre{font-size:3px;font-weight:700}.note{font-size:2.1px;fill:#475568}
+  </style></defs>`;
+
+// Les cotes utilisent les points projetés, les flèches étant orientées vers les limites.
+function dh(x1,x2,y,ref1,ref2,label) {
+  const gap=1/S, over=1.5/S;
+  return line(x1,ref1+Math.sign(y-ref1)*gap,x1,y+Math.sign(y-ref1)*over,'rappel')+
+    line(x2,ref2+Math.sign(y-ref2)*gap,x2,y+Math.sign(y-ref2)*over,'rappel')+
+    line(x1,y,x2,y,'fin',{'marker-start':'url(#fleche)','marker-end':'url(#fleche)'})+text(mid([x1,x2]),y-2/S,label,'cote');
+}
+function dv(y1,y2,x,ref1,ref2,label) {
+  const gap=1/S, over=1.5/S, cy=mid([y1,y2]);
+  return line(ref1+Math.sign(x-ref1)*gap,y1,x+Math.sign(x-ref1)*over,y1,'rappel')+
+    line(ref2+Math.sign(x-ref2)*gap,y2,x+Math.sign(x-ref2)*over,y2,'rappel')+
+    line(x,y1,x,y2,'fin',{'marker-start':'url(#fleche)','marker-end':'url(#fleche)'})+
+    text(x-2/S,cy,label,'cote',{transform:`rotate(-90 ${n(x-2/S)} ${n(cy)})`});
+}
+function leader(px,py,tx,ty,label,cls='cote') {
+  return line(tx,ty,px,py,'fin',{'marker-end':'url(#fleche)'})+text(tx,ty-2/S,label,cls);
+}
+const tag = (x,y,t,light=false) => text(x,y,t,'repere',light?{fill:'#fff',style:'fill:#fff'}:{});
+const xy = v => rect(v.x[0],-v.y[1],span(v.x),span(v.y),v.rep,{rx:v.rayon});
+const xz = (v,extra={}) => rect(v.x[0],-v.z[1],span(v.x),span(v.z),v.rep,extra);
+const yz = (v,extra={}) => rect(v.y[0],-v.z[1],span(v.y),span(v.z),v.rep,extra);
+const vs = volumes(), c=g.caisson, w=g.roues, f=g.protections.flancs, e=g.enveloppe;
+const status = (v,s) => `${fmt(v)} ${s}`;
+
+function dessus() {
+  let b='';
+  b+=xy({...c,rep:'01'});
+  b+=rect(c.x[0]+c.paroi,-c.y[1]+c.paroi,span(c.x)-2*c.paroi,span(c.y)-2*c.paroi,'01',{fill:'#f6f8fa',class:'fin'});
+  for (const v of vs.filter(v=>v.rep==='03'||v.rep==='02'||['04','05','06','07','08'].includes(v.rep))) b+=xy(v);
+  b+=xy({...g.sectionnement,rep:'09'}).replace('class="contour"','class="fantome"').replace(`fill="${C['09']}"`,'fill="none"');
+  for(const x of w.axes_x) b+=line(x,-f.y_abs[1]-7,x,f.y_abs[1]+7,'axe');
+  b+=line(-12,0,e.L+12,0,'axe');
+  b+=tag(mid(c.x),-c.y[1]+c.paroi/2,'01');
+  b+=tag(mid(g.commande.x),0,'05'); b+=tag(mid(g.batterie.x),0,'04');
+  for(const s of [-1,1]) {
+    b+=tag(mid(g.controleurs.x),s*mid(g.controleurs.y_abs),`06 ${s<0?'G':'D'}`);
+    b+=tag(mid(g.pods.x),s*mid(g.pods.y_abs),'07',true);
+    b+=tag(w.axes_x[0],s*w.voie_y,'02',true);
+    b+=tag(mid(f.x),s*mid(f.y_abs),'03');
+  }
+  b+=text(mid(g.module_avant.x),0,'08','repere');
+  b+=leader(mid(g.sectionnement.x),-mid(g.sectionnement.y),15,-60,'09 V · sur capot');
+  const target=g.cg.cible, est=g.cg.estimation_R1_1, cross=2/S;
+  b+=line(target.x-cross,-target.y,target.x+cross,-target.y)+line(target.x,-target.y-cross,target.x,-target.y+cross);
+  b+=circle(est.x,-est.y,1.3/S,{fill:'#202833',stroke:'none'});
+  b+=leader(target.x,-target.y,target.x-14,57,`CG cible ${fmt(target.x)} P`,'petit');
+  b+=leader(est.x,-est.y,est.x+28,80,`CG R1.1 ${fmt(est.x)} E`,'petit');
+  b+=dh(...c.x,-f.y_abs[1]-20,-c.y[1],-c.y[1],status(span(c.x),c.statut));
+  b+=dv(-f.y_abs[1],f.y_abs[1],-43,0,0,status(e.l,e.statut));
+  b+=dv(-c.y[1],-c.y[0],-20,c.x[0],c.x[0],status(span(c.y),c.statut));
+  b+=dv(-w.voie_y,w.voie_y,e.L+23,w.axes_x[1],w.axes_x[1],`voie ${status(w.voie,w.statut)}`);
+  b+=dh(...w.axes_x,f.y_abs[1]+20,f.y_abs[1],f.y_abs[1],status(w.empattement,w.statut));
+  b+=dh(0,w.axes_x[0],f.y_abs[1]+43,f.y_abs[1],f.y_abs[1],`X=${status(w.axes_x[0],w.statut)}`);
+  b+=dh(0,w.axes_x[1],f.y_abs[1]+66,f.y_abs[1],f.y_abs[1],`X=${status(w.axes_x[1],w.statut)}`);
+  // Longueur hors tout cotée au-dessus, sans superposer les chaînes d'axes.
+  b+=dh(0,e.L,-f.y_abs[1]-43,-f.y_abs[1],-g.pods.y_abs[1],status(e.L,e.statut));
+  b+=text(mid(g.pods.x),-g.pods.y_abs[1]-12,`R${status(g.pods.rayon,g.pods.statut)}`,'petit');
+  return b;
+}
+
+function cote() {
+  let b=xz({...c,rep:'01'});
+  b+=xz({...g.capot,rep:'10'});
+  b+=xz({...g.module_avant,rep:'08'});
+  b+=xz({...g.pods,rep:'07'});
+  b+=xz({...g.sectionnement,rep:'09'});
+  // Au premier plan, le flanc droit masque les roues et moteurs derrière lui.
+  b+=xz({...f,rep:'03'});
+  for(const x of w.axes_x) {
+    b+=circle(x,-w.axe_z,w.diametre/2,{class:'cache'});
+    b+=circle(x,-w.axe_z,g.motoreducteurs.enveloppe_diametre/2,{class:'cache'});
+    b+=line(x,-g.capot.z[1]-5,x,8,'axe')+line(x-w.diametre/2-5,-w.axe_z,x+w.diametre/2+5,-w.axe_z,'axe');
+  }
+  b+=line(-12,0,e.L+12,0,'fin');
+  b+=tag(mid(f.x),-mid(f.z),'03');b+=tag(mid(g.pods.x),-mid(g.pods.z),'07',true);
+  b+=tag(mid(g.module_avant.x),-mid(g.module_avant.z),'08');
+  b+=leader(mid(g.capot.x),-g.capot.z[1],140,-84,'10 · capot');
+  b+=leader(mid(g.sectionnement.x),-mid(g.sectionnement.z),45,-93,'09 V');
+  b+=dv(-e.h,0,e.L+22,g.module_avant.x[1],e.L,status(e.h,e.statut));
+  b+=dv(-g.capot.z[1],0,-21,c.x[0],0,`capot ${status(g.capot.z[1],g.capot.statut)}`);
+  b+=leader(w.axes_x[1]+w.diametre/2/Math.sqrt(2),-w.axe_z-w.diametre/2/Math.sqrt(2),225,-87,`Ø${status(w.diametre,w.statut_diametre)}`);
+  const guards=[['plancher',c.x[0]+c.paroi,c.z[0],25],['protections',mid(f.x),f.z[0],140],['pods',mid(g.pods.x),g.pods.z[0],285]];
+  for(const [name,x,z,tx] of guards) b+=leader(x,-z,tx,23,`${name} ${status(g.garde_sol[name],g.garde_sol.statut)}`,'petit');
+  b+=dh(0,w.axes_x[0],43,0,0,`X=${status(w.axes_x[0],w.statut)}`);
+  b+=dh(w.axes_x[0],w.axes_x[1],43,0,0,status(w.empattement,w.statut));
+  b+=dh(0,e.L,65,0,0,status(e.L,e.statut));
+  b+=text(w.axes_x[1],9,`X=${status(w.axes_x[1],w.statut)}`,'petit');
+  return b;
+}
+
+function face() {
+  let b=yz({...c,rep:'01'});
+  for(const v of vs.filter(v=>v.roue && v.id.endsWith(String(w.axes_x[1])))) b+=yz(v);
+  b+=yz({...g.capot,rep:'10'});
+  for(const s of [-1,1]) b+=yz({...f,y:signed(f.y_abs,s),rep:'03'});
+  for(const s of [-1,1]) b+=yz({...g.pods,y:signed(g.pods.y_abs,s),rep:'07'});
+  b+=yz({...g.sectionnement,rep:'09'});
+  b+=yz({...g.module_avant,rep:'08'});
+  b+=line(0,-e.h-8,0,10,'axe')+line(-e.l/2-10,0,e.l/2+10,0,'fin');
+  b+=tag(0,-mid(g.module_avant.z),'08');
+  b+=tag(mid(g.pods.y_abs),-mid(g.pods.z),'07',true);
+  b+=dh(...c.y,-e.h-19,-c.z[1],-c.z[1],status(span(c.y),c.statut));
+  b+=dh(-w.largeur_hors_tout/2,w.largeur_hors_tout/2,22,0,0,`roues ${status(w.largeur_hors_tout,w.statut)}`);
+  b+=dh(-e.l/2,e.l/2,46,0,0,`protections ${status(e.l,e.statut)}`);
+  b+=dv(-e.h,0,e.l/2+22,g.module_avant.y[1],e.l/2,status(e.h,e.statut));
+  const j=jeux(), inner=w.voie_y-w.largeur/2, outer=w.voie_y+w.largeur/2;
+  // Petits jeux : lignes de rappel, flèches extérieures et textes déportés.
+  for(const [a,bx,z,tx,label] of [[c.y[1],inner,-78,70,`jeu ${status(j.roueCaisson,w.statut)}`],[outer,f.y_abs[0],-96,145,`jeu ${status(j.roueProtection,w.statut)}`]]) {
+    b+=line(a,-w.diametre,a,z,'rappel')+line(bx,-w.diametre,bx,z,'rappel');
+    b+=line(a-8,z,a,z,'fin',{'marker-end':'url(#fleche)'})+line(bx+8,z,bx,z,'fin',{'marker-end':'url(#fleche)'});
+    b+=leader(mid([a,bx]),z,tx,z-8,label,'petit');
+  }
+  return b;
+}
+
+// Axonométrie isométrique : projection orthogonale, mêmes unités modèle que les vues.
+const iso = ([x,y,z]) => [Math.sqrt(3)/2*(x-y),(x+y)/2-z];
+const polygon3 = (pts,rep,extra={}) => path(pts.map(iso),{class:'contour',fill:C[rep],...extra});
+function prism(v,ghost=false) {
+  const [a,b]=v.x,[c,d]=v.y,[lo,hi]=v.z;
+  const extra=ghost?{class:v.rep==='09'?'fantome':'cache',fill:'none'}:{};
+  return polygon3([[b,c,lo],[b,d,lo],[b,d,hi],[b,c,hi]],v.rep,extra)+
+    polygon3([[a,d,lo],[b,d,lo],[b,d,hi],[a,d,hi]],v.rep,extra)+
+    polygon3([[a,c,hi],[b,c,hi],[b,d,hi],[a,d,hi]],v.rep,extra);
+}
+function cylinder(v) {
+  const cx=mid(v.x),cz=mid(v.z),r=span(v.x)/2;
+  const ring=y=>Array.from({length:48},(_,i)=>{const t=2*Math.PI*i/48;return [cx+r*Math.cos(t),y,cz+r*Math.sin(t)];});
+  const back=ring(v.y[0]), front=ring(v.y[1]);
+  // Surface latérale facettée finement, sans inventer de moyeu ou d'arbre.
+  let b=polygon3(back,v.rep);
+  for(let i=0;i<24;i++) b+=polygon3([back[i],back[(i+1)%48],front[(i+1)%48],front[i]],v.rep,{class:'fin',fill:C[v.rep]});
+  return b+polygon3(front,v.rep);
+}
+function roundedPod(v) {
+  const r=v.rayon, pts=[];
+  for(const [x,y,start] of [[v.x[1]-r,v.y[1]-r,0],[v.x[0]+r,v.y[1]-r,90],[v.x[0]+r,v.y[0]+r,180],[v.x[1]-r,v.y[0]+r,270]]) {
+    for(let i=0;i<=8;i++){const t=(start+i*90/8)*Math.PI/180;pts.push([x+r*Math.cos(t),y+r*Math.sin(t)]);}
+  }
+  let b='';
+  for(let i=0;i<pts.length;i++){const a=pts[i],d=pts[(i+1)%pts.length];if((a[0]+d[0])/2>mid(v.x)||(a[1]+d[1])/2>mid(v.y)) b+=polygon3([[...a,v.z[0]],[...d,v.z[0]],[...d,v.z[1]],[...a,v.z[1]]],v.rep,{class:'fin',fill:C[v.rep]});}
+  return b+polygon3(pts.map(p=>[...p,v.z[1]]),v.rep);
+}
+function ensemble() {
+  // Tri des volumes éloignés vers les volumes proches ; caisson ouvert en cinq solides.
+  const solids=vs.filter(v=>!['09','10'].includes(v.rep)).sort((a,b)=>(mid(a.x)+mid(a.y)+mid(a.z))-(mid(b.x)+mid(b.y)+mid(b.z)));
+  let b=solids.map(v=>v.cylindre?cylinder(v):v.rayon?roundedPod(v):prism(v)).join('');
+  // Capot retiré : seuls ses contours et l'emplacement de 09 sont portés en fantôme.
+  b+=polygon3([[c.x[0],c.y[0],g.capot.z[1]],[c.x[1],c.y[0],g.capot.z[1]],[c.x[1],c.y[1],g.capot.z[1]],[c.x[0],c.y[1],g.capot.z[1]]],'10',{class:'cache',fill:'none'});
+  b+=prism({...g.sectionnement,rep:'09'},true);
+  const anchors=[
+    ['01',[mid(c.x),c.y[1],c.z[1]],[-105,35]],
+    ['02',[w.axes_x[0],w.voie_y,w.axe_z],[0,170]],
+    ['03',[mid(f.x),f.y_abs[1],mid(f.z)],[-72,107]],
+    ['04',[mid(g.batterie.x),0,g.batterie.z[1]],[210,-40]],
+    ['05',[mid(g.commande.x),0,g.commande.z[1]],[20,-100]],
+    ['06',[mid(g.controleurs.x),-mid(g.controleurs.y_abs),g.controleurs.z[1]],[255,4]],
+    ['07',[mid(g.pods.x),mid(g.pods.y_abs),g.pods.z[1]],[210,230]],
+    ['08',[mid(g.module_avant.x),0,g.module_avant.z[1]],[360,80]],
+    ['09',[mid(g.sectionnement.x),0,g.sectionnement.z[1]],[-50,-70]],
+    ['10',[c.x[1],c.y[0],g.capot.z[1]],[360,154]],
+  ];
+  for(const [rep,p,[x,y]] of anchors){const [px,py]=iso(p);b+=line(px,py,x,y,'fin')+circle(x,y,3.3/S,{fill:'#fff'})+tag(x,y,rep);}
+  return b;
+}
+
+function axes(x,y,projection) {
+  let b=''; const O=[x,y];
+  for(const [label,end] of projection){b+=line(...O,x+end[0],y+end[1],'fin',{'marker-end':'url(#fleche)'})+text(x+end[0]*1.25,y+end[1]*1.25,label,'petit');}
+  return b+text(x-7,y+7,'O','petit');
+}
+function group(body,x,y){return el('g',{transform:`translate(${x} ${y}) scale(${S})`},body);}
+function svg(w,h,title,body){return `<?xml version="1.0" encoding="UTF-8"?>\n`+el('svg',{xmlns:'http://www.w3.org/2000/svg',width:`${w}mm`,height:`${h}mm`,viewBox:`0 0 ${w} ${h}`,role:'img','aria-labelledby':'titre description'},el('title',{id:'titre'},esc(`${g.meta.projet} — ${title}`))+el('desc',{id:'description'},esc(`${g.meta.repere} ${g.meta.avertissement} Chaque cote porte son statut. Orthogonales à 1:2,5.`))+defs+el('rect',{width:w,height:h,fill:'#fff'})+body)+'\n';}
+const title=(x,y,t)=>text(x,y,t,'titre');
+const small=(x,y,t)=>text(x,y,t,'note');
+const date=g.meta.date.split('-').reverse().join('/');
+const top=dessus(), side=cote(), front=face(), axon=ensemble();
+const axisTop=axes(300,135,[['X',[16,0]],['Y',[0,-16]]);
+const axisSide=axes(295,-103,[['X',[16,0]],['Z',[0,-16]]);
+const axisFace=axes(-142,-101,[['Y',[16,0]],['Z',[0,-16]]);
+
+await mkdir(new URL('svg/',import.meta.url),{recursive:true});
+const individual = [
+  ['vue_dessus.svg',200,184,'DESSUS · capot retiré',group(top+axisTop,29,91)],
+  ['vue_cote.svg',200,94,'CÔTÉ DROIT · roues et moteurs cachés',group(side+axisSide,29,61)],
+  ['vue_face.svg',200,94,'FACE AVANT · détails des jeux',group(front+axisFace,94,62)],
+  ['vue_ensemble.svg',212,164,'ENSEMBLE · capot en contour fantôme',group(axon,58,58)],
+];
+for(const [name,width,height,label,body] of individual) await writeFile(new URL(`svg/${name}`,import.meta.url),svg(width,height,label,title(7,9,`${g.meta.projet} / ${label}`)+small(7,15,`${g.meta.revision} · ${date} · mm · 1:2,5 · P : cotes provisoires`)+body));
+
+let board='';
+board+=el('rect',{x:5,y:5,width:410,height:287,fill:'none',stroke:'#27313a','stroke-width':.5});
+board+=title(9,12,`${g.meta.projet} / IMPLANTATION ET ENCOMBREMENT`)+small(295,12,`${g.meta.revision} · ${date} · ROBOTS BATTLE`);
+board+=el('path',{d:'M5 16 H415 M205 16 V246 M5 180 H205 M205 162 H415 M5 246 H415 M5 276 H415',fill:'none',stroke:'#9ba6af','stroke-width':.18});
+board+=title(9,22,'A / DESSUS · capot retiré')+group(top+axisTop,28,94);
+board+=title(210,22,'D / ENSEMBLE · capot en contour fantôme')+group(axon,260,67);
+board+=small(210,157,'Bulles 01–10 · même projection des volumes · 08 : volume réservé — non détaillé');
+board+=title(9,186,'B / CÔTÉ DROIT')+group(side+axisSide,28,218);
+board+=title(210,168,'C / FACE AVANT')+group(front+axisFace,296,222);
+board+=small(9,243,'Traits interrompus : roues / moteurs masqués · gardes au sol repérées depuis Z = 0');
+board+=title(9,252,'REPÈRES');
+const names=[['01','Caisson et plancher'],['02','Roues + motoréducteurs'],['03','Protections en U'],['04','Batterie (volume réservé)'],['05','Commande'],['06','Contrôleurs G / D'],['07','Pods arrondis'],['08','Volume réservé — non détaillé'],['09','Accès au sectionnement'],['10','Capot retiré']];
+names.forEach(([rep,label],i)=>{
+  const x=9+(i>=5?98:0), y=256+(i%5)*3.7;
+  board+=el('rect',{x,y:y-2.1,width:3,height:2.4,fill:C[rep],stroke:'#27313a','stroke-width':.18})+text(x+4,y,`${rep}  ${label}`,'papier');
+});
+board+=title(210,252,'STATUTS / SOURCE : config/geometry.json');
+Object.entries(g.meta.statuts).forEach(([code,label],i)=>{board+=text(210,256+i*3.1,`${code} — ${label}`,'papier');});
+board+=title(9,282,'PLANCHE TECHNIQUE / 4WD · MODÈLE CONCEPTUEL');
+board+=text(9,287,'Modèle conceptuel — cotes provisoires P — non destiné à la fabrication','papier');
+board+=small(9,290.5,'Origine : arrière de l’enveloppe, au sol, dans le plan de symétrie · X avant / Y gauche / Z haut');
+board+=el('path',{d:'M293 276 V292 M351 276 V292 M386 276 V292',fill:'none',stroke:'#27313a','stroke-width':.25});
+board+=text(297,281,`Révision : ${g.meta.revision}`,'papier')+text(297,287,`Date : ${date}`,'papier');
+board+=text(355,281,'Échelle : 1:2,5','papier')+text(355,287,`Unité : ${g.meta.unite}`,'papier');
+board+=text(390,281,'A3 paysage','papier')+text(390,287,'Feuille 1 / 1','papier');
+await writeFile(new URL('svg/planche_A3.svg',import.meta.url),svg(420,297,'Planche A3 paysage',board));
+await writeFile(new URL('planche_A3.html',import.meta.url),`<!doctype html>
+<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${esc(g.meta.projet)} — planche A3</title>
+<style>@page { size: A3 landscape; margin: 0 } *{box-sizing:border-box} html,body{margin:0;padding:0;background:white} img{display:block;width:420mm;height:297mm} @media screen{body{background:#e5e7eb}img{max-width:100%;height:auto;margin:auto}} @media print{html,body{width:420mm;height:297mm}img{max-width:none;break-inside:avoid;print-color-adjust:exact;-webkit-print-color-adjust:exact}}</style></head>
+<body><img src="svg/planche_A3.svg" alt="HOTLINE MK-II : quatre vues, cotes avec statuts, nomenclature et cartouche"></body></html>\n`);
+console.log('5 SVG et planche_A3.html générés depuis config/geometry.json (échelle commune 1:2,5).');
diff --git a/plans/geometrie.mjs b/plans/geometrie.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a1ac4aac4f65e1fa49eeafb41947ace5c58fe73f
--- /dev/null
+++ b/plans/geometrie.mjs
@@ -0,0 +1,42 @@
+// Géométrie commune aux dessins et contrôles ; aucune cote mécanique propre à ce module.
+import { readFile } from 'node:fs/promises';
+export const g = JSON.parse(await readFile(new URL('../config/geometry.json', import.meta.url), 'utf8'));
+export const span = a => a[1] - a[0];
+export const mid = a => (a[0] + a[1]) / 2;
+export const fmt = n => Number(n.toFixed(3)).toString().replace('.', ',');
+export const signed = (a, s) => s > 0 ? [...a] : [-a[1], -a[0]];
+export const box = (id, rep, x, y, z, extra = {}) => ({ id, rep, x, y, z, ...extra });
+export function volumes() {
+  const c = g.caisson, p = c.paroi, f = g.protections.flancs, a = g.protections.arriere;
+  const out = [
+    box('01-plancher', '01', c.x, c.y, c.plancher.z),
+    box('01-paroi-arrière', '01', [c.x[0], c.x[0] + p], c.y, [c.plancher.z[1], c.z[1]]),
+    box('01-paroi-avant', '01', [c.x[1] - p, c.x[1]], c.y, [c.plancher.z[1], c.z[1]]),
+    box('03-arrière', '03', a.x, a.y, a.z),
+    ...['batterie', 'commande', 'module_avant', 'sectionnement', 'capot'].map(k => ({ id: `${g[k].rep}-${k}`, ...g[k] })),
+  ];
+  for (const s of [-1, 1]) {
+    const cote = s > 0 ? 'G' : 'D';
+    out.push(box(`01-flanc-${cote}`, '01', [c.x[0] + p, c.x[1] - p], signed([c.y[1] - p, c.y[1]], s), [c.plancher.z[1], c.z[1]]));
+    out.push(box(`03-flanc-${cote}`, '03', f.x, signed(f.y_abs, s), f.z));
+    for (const k of ['controleurs', 'pods']) out.push(box(`${g[k].rep}-${cote}`, g[k].rep, g[k].x, signed(g[k].y_abs, s), g[k].z, { rayon: g[k].rayon }));
+    for (const x of g.roues.axes_x) {
+      const r = g.roues.diametre / 2, m = g.motoreducteurs.enveloppe_diametre / 2;
+      out.push(box(`02-roue-${cote}-${x}`, '02', [x - r, x + r], signed([g.roues.voie_y - g.roues.largeur / 2, g.roues.voie_y + g.roues.largeur / 2], s), [g.roues.axe_z - r, g.roues.axe_z + r], { cylindre: true, roue: true }));
+      out.push(box(`02-moteur-${cote}-${x}`, '02', [x - m, x + m], signed([g.motoreducteurs.y_interieur, g.motoreducteurs.y_paroi], s), [g.roues.axe_z - m, g.roues.axe_z + m], { cylindre: true, moteur: true }));
+    }
+    for (const x of g.protections.entretoises.x) {
+      const r = g.protections.entretoises.diametre / 2, z = g.protections.entretoises.z;
+      out.push(box(`03-entretoise-${cote}-${x}`, '03', [x-r, x+r], signed([c.y[1], f.y_abs[0]], s), [z-r, z+r], { cylindre: true, statut: g.protections.entretoises.statut }));
+    }
+  }
+  return out;
+}
+export function limites(vs = volumes()) {
+  return Object.fromEntries(['x', 'y', 'z'].map(k => [k, [Math.min(...vs.map(v => v[k][0])), Math.max(...vs.map(v => v[k][1]))]]));
+}
+export const jeux = () => ({
+  roueCaisson: g.roues.voie_y - g.roues.largeur / 2 - g.caisson.y[1],
+  roueProtection: g.protections.flancs.y_abs[0] - g.roues.voie_y - g.roues.largeur / 2,
+  moteurAvant: g.caisson.x[1] - g.caisson.paroi - Math.max(...g.roues.axes_x) - g.motoreducteurs.enveloppe_diametre / 2,
+});

diff --git a/plans/controle_coherence.mjs b/plans/controle_coherence.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..0c1f93a7d0419d5159d93455deea8aae6a2f136e
--- /dev/null
+++ b/plans/controle_coherence.mjs
@@ -0,0 +1,76 @@
+import { writeFile } from 'node:fs/promises';
+import { g, span, mid, fmt, volumes, limites, jeux } from './geometrie.mjs';
+
+const eps=1e-9, equal=(a,b)=>Math.abs(a-b)<eps;
+const vs=volumes(), bounds=limites(vs), j=jeux(), checks=[];
+const check=(label,ok,result,comment)=>checks.push({label,ok,result,comment});
+const tuple=a=>a.map(fmt).join(' ; ');
+const e=g.enveloppe, c=g.caisson, w=g.roues, m=g.motoreducteurs;
+check('Enveloppe réellement atteinte',equal(bounds.x[0],0)&&equal(bounds.x[1],e.L)&&equal(bounds.y[0],-e.l/2)&&equal(bounds.y[1],e.l/2)&&equal(bounds.z[0],0)&&equal(bounds.z[1],e.h),`${fmt(span(bounds.x))} × ${fmt(span(bounds.y))} × ${fmt(span(bounds.z))} mm`,`X [${tuple(bounds.x)}], Y [${tuple(bounds.y)}], Z [${tuple(bounds.z)}]. Arrière 03, avant 07, largeur 03, sol 02, sommet 08.`);
+check('Jeu roue / caisson',j.roueCaisson>0,`${fmt(j.roueCaisson)} mm`,`voie_y − largeur_roue/2 − Y_caisson_max ; quatre roues, symétrie G/D. Jeu faible : contrôle V2.`);
+check('Jeu roue / protection',j.roueProtection>0,`${fmt(j.roueProtection)} mm`,'Y_intérieur_flanc − voie_y − largeur_roue/2 ; quatre roues. Le jeu se mesure au bord intérieur du flanc.');
+check('Motoréducteur avant / paroi avant',j.moteurAvant>0,`${fmt(j.moteurAvant)} mm`,'X_caisson_max − épaisseur_paroi − X_axe_avant − Ø_moteur/2 ; confirme les 4,5 mm R1.1.');
+for(const [k,v] of [['plancher',c.plancher.z[0]],['pods',g.pods.z[0]],['protections',Math.min(g.protections.flancs.z[0],g.protections.arriere.z[0])]]) check(`Garde au sol ${k}`,equal(v,g.garde_sol[k])&&v>0,`${fmt(v)} mm`,`Dessous du solide comparé à garde_sol.${k} = ${fmt(g.garde_sol[k])} ${g.garde_sol.statut}.`);
+const offWheels=vs.filter(v=>!v.roue), minZ=Math.min(...offWheels.map(v=>v.z[0]));
+check('Garde minimale hors roues',minZ>0,`${fmt(minZ)} mm`,offWheels.filter(v=>equal(v.z[0],minZ)).map(v=>v.id).join(', '));
+check('Roues tangentes au sol',equal(w.axe_z-w.diametre/2,0),`Z bas = ${fmt(w.axe_z-w.diametre/2)} mm`,'Tangence, sans pénétration du sol.');
+for(const [name,a,b] of [
+  ['Empattement déclaré',w.empattement,Math.max(...w.axes_x)-Math.min(...w.axes_x)],
+  ['Voie déclarée',w.voie,2*w.voie_y],
+  ['Largeur roues déclarée',w.largeur_hors_tout,2*w.voie_y+w.largeur],
+  ['Longueur motoréducteur déclarée',m.enveloppe_longueur,m.y_paroi-m.y_interieur],
+  ['Épaisseur de plancher déclarée',c.plancher.epaisseur,span(c.plancher.z)],
+  ['Capot posé sur caisson',g.capot.z[0],c.z[1]],
+  ['Sectionnement posé sur capot',g.sectionnement.z[0],g.capot.z[1]],
+]) check(name,equal(a,b),`${fmt(a)} / ${fmt(b)} mm`,'Valeur déclarée / valeur recomposée depuis les bornes.');
+check('Volumes valides',vs.every(v=>['x','y','z'].every(k=>span(v[k])>0)),`${vs.length} solides`,'Boîtes d’épaisseur strictement positive, caisson décomposé en plancher et quatre parois, sans double compte aux coins.');
+check('Rayons pods compatibles',g.pods.rayon>0&&2*g.pods.rayon<=Math.min(span(g.pods.x),span(g.pods.y_abs)),`R${fmt(g.pods.rayon)}`,'Rayon en plan XY seulement ; les silhouettes XZ et YZ restent rectangulaires.');
+
+let pairs=0;const overlaps=[],contacts=[];
+for(let a=0;a<vs.length;a++)for(let b=a+1;b<vs.length;b++){
+  pairs++;
+  const p=vs[a],q=vs[b],d=['x','y','z'].map(k=>Math.min(p[k][1],q[k][1])-Math.max(p[k][0],q[k][0]));
+  if(d.every(x=>x>eps)) overlaps.push({a:p.id,b:q.id,d});
+  else if(d.every(x=>x>=-eps)&&d.some(x=>Math.abs(x)<eps)) contacts.push({a:p.id,b:q.id,d});
+}
+check('Interférences entre boîtes englobantes',overlaps.length===0,`${overlaps.length} recouvrement(s) / ${pairs} paires`,'Toutes les paires, y compris entretoises PV ; cylindres et pods arrondis approximés par leurs boîtes. Contacts sans pénétration comptés séparément.');
+
+const mass=g.masse.postes.reduce((s,p)=>s+p.g,0);
+const cg=[0,1,2].map(k=>g.masse.postes.reduce((s,p)=>s+p.g*p.position[k],0)/mass);
+const published=[g.cg.estimation_R1_1.x,g.cg.estimation_R1_1.y,g.cg.estimation_R1_1.z];
+const cgAgrees=cg.every((x,k)=>Math.round(x)===published[k]);
+const cgDelta=cg.map((x,k)=>x-published[k]);
+check('Budget de masse',mass+g.masse.reserve_g<=g.masse.maximum_publie_g,`${fmt(mass)} + ${fmt(g.masse.reserve_g)} = ${fmt(mass+g.masse.reserve_g)} g`,'Allocation et réserve, sans masse mesurée ; la réserve n’a aucune position et est exclue du CG.');
+
+const failures=checks.filter(c=>!c.ok);
+let md=`# Contrôle de cohérence — ${g.meta.projet}\n\nRévision ${g.meta.revision} — ${g.meta.date} — unité : ${g.meta.unite}.\n\nSource unique : [geometry.json](../config/geometry.json), lu sans modification. Génération : \\`node plans/generer_plans.mjs\\` ; contrôle : \\`node plans/controle_coherence.mjs\\`. Les scripts fonctionnent depuis tout répertoire courant.\n\n`;
+md+=`**Bilan géométrique : ${failures.length ? `${failures.length} contrôle(s) en échec` : 'tous les contrôles passent'} ; ${overlaps.length} interférence positive sur ${pairs} paires de ${vs.length} solides.** Ces résultats concernent les volumes conceptuels, sans tolérance, câble, fixation ni déformation.\n\n`;
+md+='## Résultats calculés\n\n| Contrôle | État | Résultat | Commentaire |\n|---|---|---|---|\n';
+md+=checks.map(c=>`| ${c.label} | ${c.ok?'OK':'ÉCHEC'} | ${c.result} | ${c.comment} |`).join('\n')+'\n\n';
+md+='## Méthode et périmètre\n\nLe caisson est creux : son enveloppe globale ne représente pas de la matière. Le contrôle utilise un plancher et quatre parois disjointes, ainsi que le capot posé, les quatre roues, quatre motoréducteurs, trois panneaux du U, quatre entretoises PV, batterie, commande, deux contrôleurs, deux pods, volume 08 et accès 09. Les entretoises suivent Y entre la face externe du caisson et la face interne des protections. Leur diamètre et leurs positions proviennent du JSON.\n\nPour chaque paire, la pénétration sur chaque axe vaut `min(maxA,maxB) − max(minA,minB)`. Une interférence exige trois valeurs strictement positives (tolérance numérique 10⁻⁹ mm). Un zéro est un contact, une valeur négative un intervalle libre. Les cylindres selon Y et les pods R10 sont remplacés par leurs boîtes : méthode conservative, susceptible de signaler des faux positifs. Aucune paire n’est ignorée. L’option de levage n’est ni dessinée ni intégrée : elle est une variante exclue de la configuration de référence. Le volume 08 est uniquement réservé, sans mécanisme.\n\n';
+md+='### Interférences positives\n\n';
+md+=overlaps.length?'| Solide A | Solide B | Pénétrations X ; Y ; Z (mm) |\n|---|---|---|\n'+overlaps.map(o=>`| ${o.a} | ${o.b} | ${tuple(o.d)} |`).join('\n')+'\n\n':'Aucune.\n\n';
+md+=`### Contacts sans pénétration (${contacts.length})\n\nLes contacts d’assemblage (plancher/parois, capot/parois, entretoises/flancs, pods/face avant, 09/capot) ne sont pas des interférences positives. Ils ne prouvent ni une fixation ni une continuité mécanique.\n\n| Solide A | Solide B | Recouvrements X ; Y ; Z (mm) |\n|---|---|---|\n`;
+md+=contacts.map(o=>`| ${o.a} | ${o.b} | ${tuple(o.d)} |`).join('\n')+'\n\n';
+md+='## Incohérences et limites du JSON / des sources\n\n';
+md+=`- **CG publié R1.1 non reproduit par les allocations du JSON.** Les postes totalisent ${fmt(mass)} g et donnent (${tuple(cg)}) mm E, hors réserve, contre (${tuple(published)}) mm E publiés. Écart calculé − publié : (${tuple(cgDelta)}) mm. ${cgAgrees?'Accord à l’arrondi au millimètre.':'Le désaccord subsiste à l’arrondi au millimètre.'} Le JSON indique lui-même que le placement exact des masses n’est pas documenté. La planche conserve le disque publié R1.1, conformément au brief ; elle ne le présente pas comme le résultat du calcul reproductible.\n`;
+md+=`- **Capot : statut mixte.** Le champ global est ${g.capot.statut}, mais sa note classe l’épaisseur ${fmt(span(g.capot.z))} mm en PV. La hauteur ${fmt(g.capot.z[1])} mm est cotée ${g.capot.statut} ; aucune épaisseur n’est cotée P sur la planche.\n`;
+// La valeur historique provient des textes fournis, et ne définit aucun dessin.
+const oldAxis=240,oldGap=c.x[1]-c.paroi-oldAxis-m.enveloppe_diametre/2;
+md+=`- **Correction historique moteur/paroi annoncée en R1.1 §4.** Avec l’ancien axe X = ${oldAxis} mm du rapport R1, les mêmes bornes et parois donnent ${fmt(oldGap)} mm, donc ${fmt(-oldGap)} mm de pénétration, et non les 1,5 mm annoncés. Le jeu actuel ${fmt(j.moteurAvant)} mm est cohérent. Ni le JSON ni les sources ne sont corrigés par ces scripts.\n`;
+md+='- Le matériau, les supports moteurs et les liaisons au caisson restent à définir. Le jeu entre enveloppe moteur et roue ne constitue pas une géométrie d’arbre ou de transmission. Les gardes nominales ne valident pas le comportement sur le sol réel.\n\n';
+md+='## Divergences R1 → R1.1 relevées\n\nSources locales : [rapport R1, §2 et §4](../sources/HOTLINE_MK-II_Rapport_final.txt) ; [dossier R1.1, §2 et §4](../sources/HOTLINE_MK-II_Dossier_R1-1.txt). Les valeurs R1 ci-dessous sont des citations de contexte, et ne pilotent jamais le dessin.\n\n| Sujet | R1 | R1.1 / JSON courant |\n|---|---|---|\n';
+md+=`| Axe avant / empattement | X = 240 / 170 mm | X = ${fmt(Math.max(...w.axes_x))} / ${fmt(w.empattement)} mm ; axe arrière inchangé à ${fmt(Math.min(...w.axes_x))} |\n`;
+md+=`| Jeu moteur avant / paroi | Avec les bornes actuelles : ${fmt(oldGap)} mm ; R1.1 relate −1,5 mm | ${fmt(j.moteurAvant)} mm ; divergence historique explicitée ci-dessus |\n`;
+md+=`| Extrémité arrière | 25 mm vides dans l’enveloppe annoncée | Panneau arrière X ${tuple(g.protections.arriere.x)} ; U fermé à l’arrière |\n`;
+md+=`| Flancs | Roues avant dépassant les protections, selon la revue R1.1 | X ${tuple(g.protections.flancs.x)} ; épaisseur ${fmt(span(g.protections.flancs.y_abs))} mm |\n`;
+md+=`| Jeu extérieur au pneu | 12,5 mm annoncés jusqu’à Y extrême ±140, sans distinguer épaisseur / jeu libre | ${fmt(j.roueProtection)} mm libres jusqu’à Y = ±${fmt(g.protections.flancs.y_abs[0])} ; ${fmt(g.protections.flancs.y_abs[1]-w.largeur_hors_tout/2)} mm jusqu’au bord extérieur |\n`;
+md+='| Vue de côté | Protection latérale omise, selon R1.1 §4 | Flanc au premier plan ; roues et moteurs derrière en interrompus |\n';
+md+=`| Contrôleurs | Décrits latéraux, dessinés au centre, selon R1.1 §4 | Deux volumes X ${tuple(g.controleurs.x)}, abs(Y) ${tuple(g.controleurs.y_abs)}, Z ${tuple(g.controleurs.z)} |\n`;
+md+=`| Pods | X 255–315 selon la source du champ pods | X ${tuple(g.pods.x)} ; avant réel à ${fmt(g.pods.x[1])} ; R${fmt(g.pods.rayon)} |\n`;
+md+=`| Centre de gravité | Cible (${tuple([g.cg.cible.x,g.cg.cible.y,g.cg.cible.z])}) ; aucun CG calculable revendiqué | Estimation publiée (${tuple(published)}) E ; calcul des allocations R2 distinct (${tuple(cg)}) E |\n`;
+md+='\nLes cotes P/H/V décrivent une proposition ou une hypothèse. Un calcul géométrique conforme n’est ni un essai ni une autorisation de fabrication. La présente revue ne vérifie pas les règles de compétition externes.\n';
+await writeFile(new URL('controle_coherence.md',import.meta.url),md.replaceAll('\\`','`'));
+console.log(`${checks.length-failures.length}/${checks.length} contrôles géométriques OK ; ${vs.length} solides ; ${pairs} paires ; ${overlaps.length} interférence ; ${contacts.length} contacts.`);
+console.log(`CG allocations : (${tuple(cg)}) mm ; CG publié : (${tuple(published)}) mm. Rapport : plans/controle_coherence.md`);
+if(failures.length)process.exitCode=1;

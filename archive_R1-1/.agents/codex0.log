/bin/bash -lc "/usr/bin/python3 - <<'PY'
import gi,cairo
from pathlib import Path
from xml.etree import ElementTree as ET
gi.require_version('Rsvg','2.0')
from gi.repository import Rsvg
for p in sorted(Path('plans/svg').glob('*.svg')):
    root=ET.parse(p).getroot()
    assert root.tag == '{http://www.w3.org/2000/svg}svg'
    ids=[el.get('id') for el in root.iter() if el.get('id')]
    assert len(ids)==len(set(ids))
    w,h=map(float,root.get('viewBox').split()[2:])
    scale=5
    surface=cairo.ImageSurface(cairo.FORMAT_ARGB32,round(w*scale),round(h*scale))
    ctx=cairo.Context(surface)
    handle=Rsvg.Handle.new_from_file(str(p.resolve()))
    viewport=Rsvg.Rectangle();viewport.x=0;viewport.y=0;viewport.width=w*scale;viewport.height=h*scale

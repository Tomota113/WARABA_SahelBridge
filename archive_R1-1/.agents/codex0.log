+}
+
+function axes(x,y,projection) {
+  let b=''; const O=[x,y];
+  for(const [label,end] of projection){b+=line(...O,x+end[0],y+end[1],'fin',{'marker-end':'url(#fleche)'})+text(x+end[0]*1.25,y+end[1]*1.25,label,'petit');}
+  return b+text(x-7,y+7,'O','petit');
+}

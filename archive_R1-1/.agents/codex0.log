r=c.CDLL('librsvg-2.so.2'); ca=c.CDLL('libcairo.so.2'); go=c.CDLL('libgobject-2.0.so.0')
def fn(lib,name,args,rest):
    f=getattr(lib,name);f.argtypes=args;f.restype=rest;return f
ptr=c.c_void_p; dbl=c.c_double; integer=c.c_int
new=fn(r,'rsvg_handle_new_from_file',[c.c_char_p,ptr],ptr)
render=fn(r,'rsvg_handle_render_cairo',[ptr,ptr],integer)
surf=fn(ca,'cairo_image_surface_create',[integer,integer,integer],ptr)
ctx=fn(ca,'cairo_create',[ptr],ptr);scale=fn(ca,'cairo_scale',[ptr,dbl,dbl],None)
png=fn(ca,'cairo_surface_write_to_png',[ptr,c.c_char_p],integer)
freeCtx=fn(ca,'cairo_destroy',[ptr],None);freeSurf=fn(ca,'cairo_surface_destroy',[ptr],None);unref=fn(go,'g_object_unref',[ptr],None)
for p in sorted(Path('plans/svg').glob('*.svg')):

+<rect class="b" x="345" y="230" width="140" height="55" rx="8"/><text class="t" x="415" y="263">Régulateur</text><path class="l" d="M415 160V230"/>
+<rect class="b" x="545" y="245" width="135" height="50" rx="8"/><text class="t" x="612" y="275">Récepteur</text><path class="d" d="M485 258H545 M612 245V230 M645 245L645 90"/>
+<text class="s" x="810" y="268">Émetteur radio → récepteur</text><path class="d" d="M745 263H680"/>
+<text class="s" x="843" y="296">Option P3 : levage lent, non coupant (après revue)</text></svg>`;

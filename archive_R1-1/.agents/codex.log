 th,.compact td{padding:1.15mm 1.5mm}.calculations{font-size:7.25pt}.calculations th,.calculations td{padding:.8mm 1.1mm}figure{margin:2mm 0 3mm;break-inside:avoid}figure img{display:block;max-width:100%;max-height:73mm;margin:auto;object-fit:contain;border:1px solid var(--line);background:white}figcaption{font-size:7.5pt;color:var(--muted);margin-top:1mm}.figgrid{display:grid;grid-template-columns:1fr 1fr;gap:3mm}.figgrid figure img{max-height:61mm}.hero img{max-height:90mm}.metric{font-size:18pt;font-weight:750;letter-spacing:-.03em}.metric small{display:block;font-size:8pt;font-weight:400;letter-spacing:0}.source{font-size:7.6pt;color:var(--muted)}a{color:inherit;text-decoration:underline;text-decoration-color:#9ca7b8}.diagram{width:100%;max-width:100%;height:auto;border:1px solid var(--line);padding:2mm;break-inside:avoid}.oral{font-size:10pt}.oral p{margin-bottom:4mm}.tight p{margin-bottom:2mm}.schedule td:first-child{white-space:nowrap}.no-break{break-inside:avoid}@media screen{body{background:#dce2e9;padding:8mm}.page{background:white;width:210mm;min-height:297mm;padding:16mm 15mm 18mm;margin:0 auto 8mm;box-shadow:0 2px 12px #8290a288}.pagehead{margin-top:-1mm}}@media print{.page{width:auto;min-height:0}.pagefoot{position:relative}a{text-decoration:none}}

const masses = table(['Poste','Allocation','Part budget','Portée'], massRows, 'compact');
const calculs = table(['Grandeur','Formule','Résultat','Statut / limite'],c.lignes.map(x=>[esc(x.libelle),esc(x.formule),`${fr(x.valeur)} ${esc(x.unite)}`,`${x.statut} · ${esc(x.portee)}`]),'compact calculations');

 const calcTable=ids=>rows(['Grandeur','Formule','Résultat','Statut et limite'],ids.map(id=>{const x=c.lignes.find(v=>v.id===id);return [e(x.libelle),e(x.formule),`${f(x.valeur)} ${e(x.unite)}`,`${x.statut} · ${e(x.limite)}`]}),'tight');
 const roles=rows(['Membre','Mission','Preuve proche'],[
  ['1','Coordination, règles, sécurité système','Fiche exigences et décisions V1/V3'],['2','Mécanique, cotes, plans','Jeux et interfaces V2'],['3','Intégration, fourches, module avant','Revue de sécurité, choix P3'],['4','Traction, radio, pilotage','Commande V4 et autonomie V5'],['5','Kit, devis, masse, dossier','Inventaire, grille FCFA, pesée V6']

const topView=()=>{const X=x=>38+x*1.47,Y=y=>160-y*1.17;return `<svg viewBox="0 0 570 330" role="img" aria-label="Vue de dessus de principe et cotes"><rect width="570" height="330" fill="white"/>${svgStyle}<rect x="${X(g.chassis.plancher.x[0])}" y="${Y(g.chassis.plancher.y[1])}" width="${(g.chassis.plancher.x[1]-g.chassis.plancher.x[0])*1.47}" height="${(g.chassis.plancher.y[1]-g.chassis.plancher.y[0])*1.17}" rx="5" class="dark"/><rect x="${X(g.batterie.x[0])}" y="${Y(g.batterie.y[1])}" width="${(g.batterie.x[1]-g.batterie.x[0])*1.47}" height="${(g.batterie.y[1]-g.batterie.y[0])*1.17}" fill="#ccd6de"/><text x="${X(24)}" y="160" class="t">04</text>${g.roues.axes_x.map(x=>[-1,1].map(sign=>`<rect x="${X(x-10)}" y="${Y(sign*g.roues.voie_y+10)}" width="29" height="23" rx="8" class="wheel"/>`).join('"'')).join('')}<rect x=\""'${X(g.flancs.x[0])}" y="${Y(g.flancs.y_abs[1])}" width="${(g.flancs.x[1]-g.flancs.x[0])*1.47}" height="6" class="dark"/><rect x="${X(g.flancs.x[0])}" y="${Y(-g.flancs.y_abs[0])}" width="${(g.flancs.x[1]-g.flancs.x[0])*1.47}" height="6" class="dark"/><ellipse cx="${X(g.module_avant.axe_x)}" cy="160" rx="${g.module_avant.rayon*1.47}" ry="${g.module_avant.y_abs*1.17}" class="gray"/><text x="${X(204)}" y="163" class="s">08 réservé</text>${[-1,1].map(s=>`<path d="M ${X(226)} ${Y(s*92)} L ${X(g.enveloppe.L)} ${Y(s*92)}" class="dim"/>`).join('"'')}<text x=\"38\" y=\"25\" class=\"t\">Arrière</text><text x=\"465\" y=\"25\" class=\"t\">Avant →</text><path d=\"M "'${X(0)} 302 H ${X(g.enveloppe.L)}" class="dim"/><text x="245" y="319" class="t">${g.enveloppe.L} mm avec fourches passives</text><text x="12" y="160" class="s">${g.enveloppe.l} mm</text></svg>`;};

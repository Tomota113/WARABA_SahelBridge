from pathlib import Path
p=Path('docs/build_docs.mjs')
s=p.read_text()
s=s.replace('La réserve de 250 g est incluse', 'La réserve de "'${g.masse.reserve_g} g est incluse'"')
s=s.replace('Le poste de 650 g regroupe', 'Le poste de "'${g.masse.postes.find(x=>x.poste==='"\\'Module avant et arceaux\\').g} g regroupe')
s=s.replace('La relation de charge est (XG − 44)/120.', 'La relation de charge est (XG − "'${g.roues.axes_x[0]})/${g.roues.empattement}.'"')
s=s.replace('La R2 utilise X = 44 mm et 120 mm', 'La R2 utilise X = "'${g.roues.axes_x[0]} mm et ${g.roues.empattement} mm'"')
s=s.replace('culminent à 95 mm', 'culminent à "'${Math.max(...g.arceaux.profil_xz.map(p=>p[1]))} mm'"')
s=s.replace('À 18 A supposés, le pack 1,5 Ah donne', 'À "'${g.hypotheses_calcul.courant_moyen_A} A supposés, le pack ${f(g.hypotheses_calcul.capacite_Ah)} Ah donne'"')
s=s.replace('le pack 2,2 Ah donne', 'le pack "'${f(g.hypotheses_calcul.capacite_alt_Ah)} Ah donne'"')
s=s.replace('avec 20 % de réserve', 'avec "'${f(100*g.hypotheses_calcul.reserve_capacite)} % de réserve'"')
s=s.replace('À 18 A supposés, 1,5 Ah donne quatre minutes avec réserve ; 2,2 Ah donne environ 5,87 minutes.', 'À "'${g.hypotheses_calcul.courant_moyen_A} A supposés, ${f(g.hypotheses_calcul.capacite_Ah)} Ah donne ${val('"\\'autonomie_15_reserve\\')} avec réserve ; "'${f(g.hypotheses_calcul.capacite_alt_Ah)} Ah donne ${val('"\\'autonomie_22_reserve\\')}.')
s=s.replace('Le budget de masse est de 3 850 g réserve comprise', 'Le budget de masse est de "'${val('"\\'masse_budget\\')} réserve comprise')
s=s.replace('À 18 A supposés :', 'À "'${g.hypotheses_calcul.courant_moyen_A} A supposés :'"')
s=s.replace('avec 1,5 Ah ou', 'avec "'${f(g.hypotheses_calcul.capacite_Ah)} Ah ou'"')
s=s.replace('avec 2,2 Ah et réserve', 'avec "'${f(g.hypotheses_calcul.capacite_alt_Ah)} Ah et réserve'"')
p.write_text(s)

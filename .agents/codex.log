import { readFile, writeFile } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import path from 'node:path';

const dir=path.dirname(fileURLToPath(import.meta.url));
const g=JSON.parse(await readFile(path.join(dir,'../config/geometry.json'),'utf8'));
const c=JSON.parse(await readFile(path.join(dir,'calculs.json'),'utf8'));
if(c.meta.nom"'!==g.meta.nom || c.meta.revision!==g.meta.revision) throw new Error('"'calculs.json obsolète : relancer node docs/calculs.mjs');
const e=s=>String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('\"','&quot;');
const f=n=>new Intl.NumberFormat('fr-FR',{maximumFractionDigits:2}).format(n);
const val=id=>{const v=c.lignes.find(x=>x.id===id);if("'!v)throw new Error(`Calcul absent : ${id}`);return `${f(v.valeur)} ${v.unite}`;};
const rows=(headers,data,cls='"'')=>"'`<table class="${cls}"><thead><tr>${headers.map(x=>`<th>${e(x)}</th>`).join('"'')}</tr></thead><tbody>"'${data.map(r=>`<tr>${r.map(x=>`<td>${x}</td>`).join('"'')}</tr>"'`).join('"'')}</tbody></table>"'`;
const cap=(title,body)=>`<div class="card"><h3>${e(title)}</h3>${body}</div>`;
const source=`Règles publiées : <a href="${e(g.regles_publiees.url_categorie)}">Robots Battle</a>, <a href="${e(g.regles_publiees.url_reglement)}">règlement</a>, <a href="${e(g.regles_publiees.url_calendrier)}">calendrier</a> ; consultation ${e(g.regles_publiees.consultation)}.`;
const page=(label,n,body)=>`<section class="page"><div class="topline">${e(g.meta.nom)} · ${e(g.meta.equipe)} <span>${e(label)} · R2</span></div>${body}<div class="foot">Dossier de conception R2 · 16 octobre 2026 <span>${n}</span></div></section>`;
const css=`@page { size: A4; margin: 15mm }
:root{--navy:#1b2a41;--red:#c62828;--muted:#586675;--line:#d6dce2;--soft:#f3f5f7}
*{box-sizing:border-box}html{font-family:Arial,Helvetica,system-ui,sans-serif;color:var(--navy);font-size:9.2pt;line-height:1.28}body{margin:0}h1{font-size:28pt;line-height:1.05;margin:3mm 0 5mm}h2{font-size:14pt;line-height:1.15;margin:4mm 0 2mm}h3{font-size:10pt;margin:2mm 0 1mm}p{margin:0 0 2.5mm}ul,ol{margin:1mm 0 2.5mm;padding-left:5mm}li{margin:0 0 1mm}.kicker{font-size:9pt;color:var(--red);font-weight:bold;letter-spacing:.08em;text-transform:uppercase}.subtitle{font-size:12pt;color:var(--muted);margin-bottom:5mm}.lead{font-size:11pt;line-height:1.38}.small,.source,.note,figcaption{font-size:7.8pt;color:var(--muted)}.source{margin-top:3mm}.note{border-left:2px solid var(--red);padding:1mm 2mm;background:var(--soft)}.page{break-after:page;page-break-after:always;position:relative}.page:last-child{break-after:auto;page-break-after:auto}.topline,.foot{font-size:7.3pt;color:var(--muted);border-bottom:1px solid var(--line);padding-bottom:2mm;margin-bottom:3mm}.topline span,.foot span{float:right}.foot{border-top:1px solid var(--line);border-bottom:0;margin-top:3mm;padding-top:2mm}.rule{height:2px;width:22mm;background:var(--red);margin:4mm 0}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:4mm}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:3mm}.card{background:var(--soft);padding:2.5mm;break-inside:avoid}.card p:last-child{margin:0}.stat{font-size:17pt;font-weight:bold}.stat small{display:block;font-size:7.5pt;color:var(--muted);font-weight:normal}.badge{display:inline-block;border:1px solid var(--line);padding:1mm 2mm;font-size:8pt;color:var(--muted);margin-bottom:3mm}table{width:100%;border-collapse:collapse;margin:2mm 0 3mm;font-size:8pt;break-inside:avoid}thead{background:var(--navy);color:white}th,td{padding:1.4mm 1.5mm;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}tbody tr:nth-child(even){background:#f8f9fb}.tight{font-size:7.3pt}.tight th,.tight td{padding:1mm 1.1mm}.micro{font-size:6.9pt}.micro th,.micro td{padding:.85mm}.key{color:var(--red);font-weight:bold}figure{margin:2mm 0 3mm;break-inside:avoid}figure img,figure svg{display:block;width:100%;max-height:83mm;object-fit:contain;border:1px solid var(--line);background:white}figcaption{margin-top:1mm}.twoview{display:grid;grid-template-columns:1fr 1fr;gap:3mm}.twoview figure svg,.twoview figure img{max-height:64mm}.hero svg,.hero img{max-height:92mm}.mini svg,.mini img{max-height:56mm}.diagram{width:100%;height:auto;border:1px solid var(--line);break-inside:avoid}.oral p{margin:0 0 3mm}.oral strong{color:var(--navy)}a{color:inherit;text-decoration:underline;text-decoration-color:#9aabbc}code{font-family:ui-monospace,monospace;font-size:8pt}.question{font-weight:bold;color:var(--red)}@media screen{body{background:#dce2e9;padding:7mm}.page{background:white;width:210mm;min-height:297mm;padding:15mm;margin:0 auto 6mm;box-shadow:0 2px 9px #9ba8b4}}@media print{.page{width:auto;min-height:0}a{text-decoration:none}}`;
const shell=(title,pages)=>`<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${e(title)} — ${e(g.meta.nom)}</title><style>${css}</style></head><body>${pages.join('"'')}</body></html>"'`;

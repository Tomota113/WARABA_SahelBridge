  [`${g.caisson.rep} Caisson`,`${g.caisson.x[1]-g.caisson.x[0]} × ${g.caisson.y[1]-g.caisson.y[0]} · X ${g.caisson.x.join('–')} · paroi ${g.caisson.paroi}`,`${g.caisson.statut} · plancher ${g.caisson.plancher.epaisseur} H`],
  [`${g.roues.rep} Roues / axes`,`Ø${g.roues.diametre} × ${g.roues.largeur} · X ${g.roues.axes_x.join(' / ')} · empattement ${g.roues.empattement}`,`Ø H · implantation P`],
  [`${g.protections.rep} Protections`,`flancs X ${g.protections.flancs.x.join('–')} · Y ±${g.protections.flancs.y_abs.join(' à ±')}`,`${g.protections.statut} · U remplaçable`],
  [`${g.batterie.rep} Batterie`,`X ${g.batterie.x.join('–')} · Y ${g.batterie.y.join(' à ')} · Z ${g.batterie.z.join('–')}`,`${g.batterie.statut} · volume réservé`],
  [`${g.module_avant.rep} Module avant`,`X ${g.module_avant.x.join('–')} · Y ${g.module_avant.y.join(' à ')} · Z ${g.module_avant.z.join('–')}`,`${g.module_avant.statut} · volume neutralisé`],
], 'compact');
const massRows = c.postes.map(x=>[esc(x.poste),`${x.g} g`,`${fr(x.part_pct)} %`,esc(x.note)]);

from html.parser import HTMLParser
from pathlib import Path
import json,csv,re
class Check(HTMLParser):
 def __init__(self): super().__init__(); self.stack=[];self.bad=[];self.pages=0;self.figures=0
 def handle_starttag(self,t,a):
  if t=='section' and ('class','page') in a:self.pages+=1
  if t=='figure':self.figures+=1
  if t not in {'br','hr','img','meta','link','input','source','area','base','col','embed','param','track','wbr'}:self.stack.append(t)
 def handle_endtag(self,t):
  if t in self.stack:
   while self.stack and self.stack[-1]"'!=t:self.bad.append(self.stack.pop())
   self.stack.pop()
  else:self.bad.append('"'/'+t)
 def handle_startendtag(self,t,a):pass
for n,maxp in [('rapport_interne',7),('dossier_jury',7),('fiche_orale',3)]:
 text=Path('docs/'+n+'.html').read_text();h=Check();h.feed(text)
 assert h.pages<=maxp and h.pages>0,(n,h.pages)
 assert not h.bad and not h.stack,(n,h.bad[:8],h.stack[:8])
 assert not re.search(r'NaN|undefined|\\"'$'"\\{',text),n
 assert '@page { size: A4; margin: 15mm }' in text
 if n"'!='"'rapport_interne':
  for bad in ['Hotline','HOTLINE','Three.js','JSON','Node','URDF','ROS','moteur physique']:
   assert bad not in text,(n,bad)
 print(n,'sections',h.pages,'figures',h.figures,'HTML balance OK')
calc=json.loads(Path('docs/calculs.json').read_text());d={x['id']:x['valeur'] for x in calc['lignes']}
for k,v in {'autonomie_15_ideale':5,'autonomie_15_reserve':4,'autonomie_22_reserve':5.87,'courant_voie':9,'masse_budget':3850,'marge':150,'cg_avec_x':120.43,'charge_avec':63.7,'cg_sans_x':99.59,'charge_sans':46.3}.items():assert d[k]==v,(k,d[k],v)
assert all(x['ok'] for x in calc['controles'])
with Path('docs/budget_grille.csv').open(newline='') as f:
 rows=list(csv.reader(f)); assert all(len(r)==len(rows[0]) for r in rows)
 print('budget rows',len(rows)-1,'prices blank',all(not r[4] for r in rows[1:]))
print('calculations and geometry checks OK')

 ], 'tight');
-const masses=rows(['Poste','Allocation','Part du budget'],[...c.postes.map(p=>[e(p.poste),`${f(p.g)} g`,`${f(p.part_pct)} %`]),['Réserve non localisée',`${f(g.masse.reserve_g)} g`,`${f(100*g.masse.reserve_g/val('masse_budget').split(' ')[0].replace(',','.'))} %`]],'tight');

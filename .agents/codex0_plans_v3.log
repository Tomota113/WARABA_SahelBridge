+    x:[Math.min(...t.poulies.x)-r,Math.max(...t.poulies.x)+r],
+    y:signed(t.poulies.y_abs,s),z:[Math.min(...zs)-r,Math.max(...zs)+r],
+  },{conservative:true}));
+}

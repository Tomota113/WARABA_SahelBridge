+export function platineXY(s=1) {
+  const {x,y_abs:y}=g.flancs.platines;
+  return [[x[0],y[0]],[x[1],y[0]],[x[1]-retraitPlatine,y[1]],[x[0]+retraitPlatine,y[1]]].map(([x,y])=>[x,s*y]);

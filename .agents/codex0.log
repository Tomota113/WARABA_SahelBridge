+  push(top,(v.holes??[]).map(p=>p.map(([x,z])=>[x,v.y[1],z])));
+  push(bottom,(v.holes??[]).map(p=>p.map(([x,z])=>[x,v.y[0],z])));
+  for(const p of [base,...(v.holes??[])])for(let i=0;i<p.length;i++) {

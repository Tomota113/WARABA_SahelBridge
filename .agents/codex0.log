+  for(const v of vs.filter(v=>v.id.startsWith('controleur-')))b+=text(mid(v.x),-mid(v.y),`06 ${v.id.endsWith('G')?'G':'D'}`,'repere');
+  for(const v of vs.filter(v=>v.id.startsWith('moteur-')))b+=tag(mid(v.x),-mid(v.y),'02');

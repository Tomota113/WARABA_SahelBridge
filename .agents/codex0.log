+  b+=projectXY(vs.find(v=>v.id==='module-08'));
+  const cut=vs.find(v=>v.id==='sectionnement');b+=rect(cut.x[0],-cut.y[1],span(cut.x),span(cut.y),'09',{class:'fantome',fill:'none'});

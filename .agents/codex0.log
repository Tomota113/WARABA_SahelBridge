+  b+=leader(mid(vs.find(v=>v.id==='arceau-G').x),-mid(g.arceaux.y_abs),260,-82,'11','petit');
+  b+=dh(0,g.enveloppe.L,-f.y_abs[1]-39,0,-mid(g.fourches.y_abs),status(g.enveloppe.L,g.enveloppe.statut));

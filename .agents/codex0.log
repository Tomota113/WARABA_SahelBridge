  ['Axes des roues en X',wheel.axes_x.map(fmt).join(' / '),fmt(span(wheel.axes_x))+' d’empattement',wheel.statut],
  ['Voie entre centres',\`2 × ${fmt(wheel.voie_y)}\`,fmt(wheel.voie),wheel.statut],

+board+=title(210,143,'P3 / LEVAGE LENT · option à la place de 08');
+board+=group(variant,178,173)+note(343,151,'Palette arrondie, non coupante')+note(343,155,'Principe seulement · statut P');
+board+=title(10,181,'B / CÔTÉ DROIT')+group(side,29,224);
+board+=title(210,181,'C / FACE AVANT')+group(front,301,224);
+board+=title(10,255,'REPÈRES / COULEURS PAR SOUS-ENSEMBLE');
+const names=[['01','Châssis'],['02','Roues + transmission'],['03','Flancs + pare-chocs'],['04','Batterie'],['05','Commande + distribution'],['06','Contrôleurs G / D'],['07','Pods'],['08','Module avant — enveloppe'],['09','Coupe-circuit'],['10','Capot (contour seul)'],['11','Arceaux triangulaires'],['12','Fourches passives']];
+names.forEach(([rep,label],i)=>{
+  const col=Math.floor(i/4),row=i%4,x=10+col*65,y=260+row*3.7;
+  board+=el('rect',{x,y:y-2,width:3,height:2.5,fill:C[rep],stroke:'#293440','stroke-width':.18})+text(x+4,y,`${rep}  ${label}`,'papier');
+});
+board+=title(210,255,'STATUTS / SOURCE UNIQUE : config/geometry.json');
+Object.entries(g.meta.statuts).forEach(([code,label],i)=>{board+=text(210,260+i*3.1,`${stamp(code)} — ${label}`,'papier');});
+board+=text(10,283,`${g.meta.nom} · ${g.meta.equipe} · Plans ${g.meta.revision}`,'titre');
+board+=text(10,287,'Modèle conceptuel — cotes provisoires — non destiné à la fabrication','papier');
+board+=note(10,290.5,'O : sol / symétrie / arrière du pare-chocs · X avant / Y gauche / Z haut');
+board+=el('path',{d:'M285 277 V292 M335 277 V292 M378 277 V292',fill:'none',stroke:'#293440','stroke-width':.25});
+board+=text(289,283,`Date : ${date}`,'papier')+text(289,288,`Révision : ${g.meta.revision}`,'papier');
+board+=text(339,283,'Échelle : 1:2,5','papier')+text(339,288,`Unité : ${g.meta.unite}`,'papier');
+board+=text(382,283,'A3 paysage','papier')+text(382,288,'Feuille 1 / 1','papier');
+await writeFile(new URL('svg/planche_A3.svg',import.meta.url),svg(420,297,'Planche A3 paysage',board));
+await writeFile(new URL('planche_A3.html',import.meta.url),`<!doctype html>
+<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${esc(g.meta.nom)} — Plans ${esc(g.meta.revision)} — A3</title>
+<style>@page { size: A3 landscape; margin: 0 } *{box-sizing:border-box} html,body{margin:0;padding:0} img{display:block;width:420mm;height:297mm} @media screen{body{background:#e5e7eb}img{max-width:100%;height:auto;margin:auto;box-shadow:0 2px 24px #0002}} @media print{html,body{width:420mm;height:297mm;background:white}img{max-width:none;break-inside:avoid;print-color-adjust:exact;-webkit-print-color-adjust:exact}}</style></head>
+<body><img src="svg/planche_A3.svg" alt="${esc(g.meta.nom)} — ${esc(g.meta.equipe)} : plans R2, quatre vues, variante de levage P3, repères 01 à 12 et cotes provisoires en millimètres."></body></html>\n`);
+console.log(`${g.meta.nom} : 6 SVG et planche_A3.html générés ; échelle commune 1:2,5, source config/geometry.json.`);
diff --git a/plans/geometrie.mjs b/plans/geometrie.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..6a6896390cfecace5226f0783c3c6ea63bb93891
--- /dev/null
+++ b/plans/geometrie.mjs
@@ -0,0 +1,126 @@
+// Source commune aux projections et aux contrôles. Toutes les dimensions viennent du JSON.
+import { readFile } from 'node:fs/promises';
+export const g = JSON.parse(await readFile(new URL('../config/geometry.json', import.meta.url), 'utf8'));
+export const span = a => a[1] - a[0];
+export const mid = a => (a[0] + a[1]) / 2;
+export const fmt = x => Number(x.toFixed(3)).toString().replace('.', ',');
+export const signed = (a, s) => s > 0 ? [...a] : [-a[1], -a[0]];
+export const rectXZ = (x,z) => [[x[0],z[0]],[x[1],z[0]],[x[1],z[1]],[x[0],z[1]]];
+export const ring = (x,z,r,n=128) => Array.from({length:n},(_,i)=>[x+r*Math.cos(i*2*Math.PI/n),z+r*Math.sin(i*2*Math.PI/n)]);
+export const extents = p => ({x:[Math.min(...p.map(q=>q[0])),Math.max(...p.map(q=>q[0]))],z:[Math.min(...p.map(q=>q[1])),Math.max(...p.map(q=>q[1]))]});
+const profile = (id,rep,p,y,extra={}) => ({id,rep,p,y,...extents(p),...extra});
+const box = (id,rep,v,extra={}) => profile(id,rep,rectXZ(v.x,v.z),v.y,extra);
+const cyl = (id,rep,x,z,r,y,extra={}) => profile(id,rep,ring(x,z,r),y,{cx:x,cz:z,r,cylinder:true,...extra});
+export function podProfile() {
+  const {x,z,chanfrein:c}=g.pods;
+  return [[x[0],z[0]],[x[1]-c,z[0]],[x[1],z[0]+c],[x[1],z[1]],[x[0],z[1]]];
+}
+export function volumes() {
+  const c=g.chassis,t=g.transmission,w=g.roues,out=[
+    box('plancher','01',c.plancher),box('cloison','01',c.cloison_av),
+    box('pare-chocs','03',g.pare_chocs,{color:'#6f9ad8'}),
+    box('support-moteurs','02',t.support,{color:'#9aa3ad'}),
+    ...['batterie','commande','distribution','sectionnement','capot'].map(k=>box(k,g[k].rep,g[k])),
+    cyl('module-08','08',g.module_avant.axe_x,g.module_avant.axe_z,g.module_avant.rayon,[-g.module_avant.y_abs,g.module_avant.y_abs]),
+  ];
+  for(const s of [-1,1]) {
+    const side=s>0?'G':'D',y=v=>signed(v.y_abs,s);
+    out.push(box(`rail-${side}`,'01',{...c.rails_int,y:y(c.rails_int)}));
+    out.push(profile(`flanc-${side}`,'03',g.flancs.profil_xz,y(g.flancs)));
+    out.push(profile(`arceau-${side}`,'11',g.arceaux.profil_xz,y(g.arceaux),{holes:[g.arceaux.evidement_xz]}));
+    out.push(profile(`pod-${side}`,'07',podProfile(),y(g.pods)));
+    out.push(profile(`fourche-${side}`,'12',g.fourches.profil_xz,y(g.fourches)));
+    out.push(box(`controleur-${side}`,'06',{...g.controleurs,y:y(g.controleurs)}));
+    out.push(cyl(`moteur-${side}`,'02',t.moteurs.x,t.moteurs.z,t.moteurs.diametre/2,y(t.moteurs),{color:'#9aa3ad'}));
+    for(const x of w.axes_x) {
+      out.push(cyl(`roue-${side}-${x}`,'02',x,w.axe_z,w.diametre/2,signed([w.voie_y-w.largeur/2,w.voie_y+w.largeur/2],s),{wheel:true,color:'#e9a197'}));
+      out.push(cyl(`axe-roue-${side}-${x}`,'02',x,w.axe_z,g.flancs.axes_roues.diametre/2,signed([c.rails_int.y_abs[1],g.flancs.y_abs[0]],s),{color:'#6b7280'}));
+    }
+    for(const x of t.poulies.x) {
+      // Coaxialité : poulies de roues à axe_z ; poulie motrice à moteurs.z.
+      const z=w.axes_x.includes(x)?w.axe_z:t.moteurs.z;
+      out.push(cyl(`poulie-${side}-${x}`,'02',x,z,t.poulies.diametre/2,y(t.poulies),{pulley:true,color:'#6b7280'}));
+    }
+  }
+  return out;
+}
+export function limites(vs=volumes()) {
+  return Object.fromEntries(['x','y','z'].map(k=>[k,[Math.min(...vs.map(v=>v[k][0])),Math.max(...vs.map(v=>v[k][1]))]]));
+}
+export function jeux() {
+  const w=g.roues,t=g.transmission,m=g.module_avant;
+  return {
+    rouePod:g.pods.x[0]-(Math.max(...w.axes_x)+w.diametre/2),
+    roueRail:w.voie_y-w.largeur/2-g.chassis.rails_int.y_abs[1],
+    roueFlanc:g.flancs.y_abs[0]-(w.voie_y+w.largeur/2),
+    poulieRoue:w.voie_y-w.largeur/2-t.poulies.y_abs[1],
+    poulieRail:t.poulies.y_abs[0]-g.chassis.rails_int.y_abs[1],
+    moduleArceau:g.arceaux.y_abs[0]-m.y_abs,
+    moduleCapotAxial:m.axe_x-m.rayon-g.capot.x[1],
+    moduleCapotReel:Math.hypot(m.axe_x-g.capot.x[1],m.axe_z-g.capot.z[1])-m.rayon,
+    moduleSol:m.axe_z-m.rayon,
+    batterieMoteur:t.moteurs.x-t.moteurs.diametre/2-g.batterie.x[1],
+    batterieCapot:g.capot.z[0]-g.batterie.z[1],
+  };
+}
+
+// Intersections de profils XZ : triangulation des polygones concaves, puis découpe
+// de triangles convexes. Les évidements sont soustraits ; les cylindres sont
+// approchés par 128 segments (écart radial max : r*(1-cos(pi/128))).
+const EPS=1e-8;
+const cross=(a,b,c)=>(b[0]-a[0])*(c[1]-a[1])-(b[1]-a[1])*(c[0]-a[0]);
+export const area=p=>Math.abs(signedArea(p));
+function signedArea(p){return p.reduce((a,q,i)=>{const r=p[(i+1)%p.length];return a+q[0]*r[1]-r[0]*q[1];},0)/2;}
+function ccw(p){return signedArea(p)<0?[...p].reverse():[...p];}
+function insideTriangle(p,a,b,c){return cross(a,b,p)>=-EPS&&cross(b,c,p)>=-EPS&&cross(c,a,p)>=-EPS;}
+export function triangulate(poly) {
+  const p=ccw(poly),out=[];
+  while(p.length>3) {
+    let found=false;
+    for(let i=0;i<p.length;i++) {
+      const a=p[(i+p.length-1)%p.length],b=p[i],c=p[(i+1)%p.length];
+      if(cross(a,b,c)<=EPS) continue;
+      if(p.some(q=>q!==a&&q!==b&&q!==c&&insideTriangle(q,a,b,c))) continue;
+      out.push([a,b,c]);p.splice(i,1);found=true;break;
+    }
+    if(!found) throw new Error('Profil dégénéré ou auto-intersectant');
+  }
+  if(p.length===3) out.push(p);
+  return out;
+}
+function convexIntersection(subject,clip) {
+  let out=subject;
+  for(let i=0;i<clip.length&&out.length;i++) {
+    const a=clip[i],b=clip[(i+1)%clip.length],input=out;out=[];
+    for(let j=0;j<input.length;j++) {
+      const p=input[j],q=input[(j+1)%input.length],cp=cross(a,b,p),cq=cross(a,b,q);
+      if(cp>=-EPS) out.push(p);
+      if((cp>EPS&&cq< -EPS)||(cp< -EPS&&cq>EPS)) {
+        const t=cp/(cp-cq);out.push([p[0]+t*(q[0]-p[0]),p[1]+t*(q[1]-p[1])]);
+      }
+    }
+  }
+  return out;
+}
+const tris=new WeakMap();
+const triangles=p=>{if(!tris.has(p))tris.set(p,triangulate(p));return tris.get(p);};
+export function intersectionArea(p,q) {
+  let a=0;
+  for(const t of triangles(p))for(const u of triangles(q))a+=area(convexIntersection(t,u));
+  return a;
+}
+export function interference(a,b) {
+  const d=Object.fromEntries(['x','y','z'].map(k=>[k,Math.min(a[k][1],b[k][1])-Math.max(a[k][0],b[k][0])]));
+  if(Object.values(d).some(x=>x<=EPS)) return null;
+  let aXZ=intersectionArea(a.p,b.p);
+  for(const h of a.holes??[])aXZ-=intersectionArea(h,b.p);
+  for(const h of b.holes??[])aXZ-=intersectionArea(a.p,h);
+  for(const h of a.holes??[])for(const j of b.holes??[])aXZ+=intersectionArea(h,j);
+  return aXZ>EPS?{d,area:aXZ,volume:aXZ*d.y}:null;
+}
+export const expectedOverlap=(a,b)=>{
+  const ids=[a.id,b.id].sort();
+  if(ids.some(x=>x.startsWith('fourche-'))&&ids.some(x=>x.startsWith('pod-')))return 'Engagement volontaire de la fourche dans le pod ; logement non détaillé';
+  if(ids.some(x=>x.startsWith('axe-roue-'))&&ids.some(x=>x.startsWith('roue-')||x.startsWith('poulie-')))return 'Liaison coaxiale d’assemblage ; alésages non détaillés';
+  return null;
+};
diff --git a/plans/valider_rendu.py b/plans/valider_rendu.py
new file mode 100644
index 0000000000000000000000000000000000000000..533c1cc598deff2a0d4d95ef816bd9f316863e0e
--- /dev/null
+++ b/plans/valider_rendu.py
@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+"""Validation XML et aperçu sans navigateur, avec les bibliothèques système.
+
+Usage : python plans/valider_rendu.py
+Librsvg/Cairo produisent des aperçus PNG et un PDF A3 vectoriel, dans plans/.
+Libxml2 est le moteur XML de xmllint, utilisé ici si son exécutable est absent.
+"""
+import ctypes as c
+import ctypes.util
+from pathlib import Path
+import xml.etree.ElementTree as ET
+
+ROOT = Path(__file__).resolve().parent
+
+
+def library(name):
+    path = ctypes.util.find_library(name)
+    if not path:
+        raise RuntimeError(f"Bibliothèque système manquante : {name}")
+    return c.CDLL(path)
+
+
+def api(lib, name, result, *args):
+    f = getattr(lib, name)
+    f.restype = result
+    f.argtypes = list(args)
+    return f
+
+
+xml = library('xml2')
+read_xml = api(xml, 'xmlReadFile', c.c_void_p, c.c_char_p, c.c_char_p, c.c_int)
+free_xml = api(xml, 'xmlFreeDoc', None, c.c_void_p)
+rsvg, cairo, gobject = library('rsvg-2'), library('cairo'), library('gobject-2.0')
+new_svg = api(rsvg, 'rsvg_handle_new_from_file', c.c_void_p, c.c_char_p, c.c_void_p)
+set_dpi = api(rsvg, 'rsvg_handle_set_dpi', None, c.c_void_p, c.c_double)
+unref = api(gobject, 'g_object_unref', None, c.c_void_p)
+create_image = api(cairo, 'cairo_image_surface_create', c.c_void_p, c.c_int, c.c_int, c.c_int)
+create_pdf = api(cairo, 'cairo_pdf_surface_create', c.c_void_p, c.c_char_p, c.c_double, c.c_double)
+create_context = api(cairo, 'cairo_create', c.c_void_p, c.c_void_p)
+destroy_context = api(cairo, 'cairo_destroy', None, c.c_void_p)
+destroy_surface = api(cairo, 'cairo_surface_destroy', None, c.c_void_p)
+finish_surface = api(cairo, 'cairo_surface_finish', None, c.c_void_p)
+surface_status = api(cairo, 'cairo_surface_status', c.c_int, c.c_void_p)
+write_png = api(cairo, 'cairo_surface_write_to_png', c.c_int, c.c_void_p, c.c_char_p)
+
+
+class Rectangle(c.Structure):
+    _fields_ = [('x', c.c_double), ('y', c.c_double), ('width', c.c_double), ('height', c.c_double)]
+
+
+render = api(rsvg, 'rsvg_handle_render_document', c.c_int, c.c_void_p, c.c_void_p, c.POINTER(Rectangle), c.c_void_p)
+preview = ROOT / 'apercus'
+preview.mkdir(exist_ok=True)
+for path in sorted((ROOT / 'svg').glob('*.svg')):
+    doc = read_xml(str(path).encode(), None, 2048)  # XML_PARSE_NONET
+    if not doc:
+        raise RuntimeError(f"XML invalide : {path}")
+    free_xml(doc)
+    tree = ET.parse(path)
+    ids = [el.attrib['id'] for el in tree.iter() if 'id' in el.attrib]
+    assert len(ids) == len(set(ids)), f"Identifiants SVG dupliqués : {path}"
+    for el in tree.iter():
+        for value in el.attrib.values():
+            if value.startswith('url(#'):
+                assert value[5:-1] in ids, (path, value)
+    width, height = map(float, tree.getroot().attrib['viewBox'].split()[2:])
+    handle = new_svg(str(path).encode(), None)
+    assert handle, f"SVG non rendu : {path}"
+    set_dpi(handle, 96)
+    pixels_per_mm = 5
+    surface = create_image(0, round(width * pixels_per_mm), round(height * pixels_per_mm))
+    cr = create_context(surface)
+    viewport = Rectangle(0, 0, width * pixels_per_mm, height * pixels_per_mm)
+    assert render(handle, cr, c.byref(viewport), None), f"Échec rendu {path}"
+    output = preview / (path.stem + '.png')
+    assert write_png(surface, str(output).encode()) == 0
+    destroy_context(cr)
+    destroy_surface(surface)
+    if path.stem == 'planche_A3':
+        points_per_mm = 72 / 25.4
+        surface = create_pdf(str(ROOT / 'planche_A3.pdf').encode(), width * points_per_mm, height * points_per_mm)
+        cr = create_context(surface)
+        viewport = Rectangle(0, 0, width * points_per_mm, height * points_per_mm)
+        assert render(handle, cr, c.byref(viewport), None)
+        destroy_context(cr)
+        finish_surface(surface)
+        assert surface_status(surface) == 0
+        destroy_surface(surface)
+    unref(handle)
+    print(f"XML libxml2 + références SVG + rendu : {path.relative_to(ROOT)} OK")
+print('Aperçus dans plans/apercus/ ; plans/planche_A3.pdf : A3 vectoriel, sans navigateur.')

diff --git a/plans/generer_plans.mjs b/plans/generer_plans.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..22170c555d35ef4d1bbcf4d8773f9d4246b62005
--- /dev/null
+++ b/plans/generer_plans.mjs
@@ -0,0 +1,294 @@
+import { mkdir, writeFile } from 'node:fs/promises';
+import { g, span, mid, fmt, volumes, rectXZ, ring, podProfile } from './geometrie.mjs';
+
+// Constantes de dessin uniquement : mm papier, projection, typographie et couleurs.
+// 1:2,5 conserve les quatre vues et la variante lisibles sur une seule feuille A3.
+const S=1/2.5;
+const C={'01':'#cfd5dc','02':'#e9a197','03':'#8c939b','04':'#9fb8d6','05':'#b9c7b0','06':'#b9c7b0','07':'#e57373','08':'url(#hachures08)','09':'#d0352b','10':'none','11':'#4b5563','12':'#a7adb4'};
+const esc=x=>String(x).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');
+const n=x=>Number(x.toFixed(5));
+const el=(tag,a={},body='')=>`<${tag}${Object.entries(a).filter(([,v])=>v!==undefined).map(([k,v])=>` ${k}="${esc(v)}"`).join('')}>${body}</${tag}>`;
+const line=(x1,y1,x2,y2,cls='fin',extra={})=>el('line',{x1:n(x1),y1:n(y1),x2:n(x2),y2:n(y2),class:cls,...extra});
+const text=(x,y,label,cls='texte',extra={})=>el('text',{x:n(x),y:n(y),class:cls,...extra},esc(label));
+const pathD=p=>p.map((q,i)=>`${i?'L':'M'}${q.map(n).join(',')}`).join(' ')+' Z';
+const poly=(p,rep,extra={})=>el('path',{d:pathD(p),fill:C[rep],class:'contour',...extra});
+const rect=(x,y,w,h,rep,extra={})=>el('rect',{x:n(x),y:n(y),width:n(w),height:n(h),fill:C[rep],class:'contour',...extra});
+const circle=(x,y,r,extra={})=>el('circle',{cx:n(x),cy:n(y),r:n(r),class:'contour',...extra});
+const group=(body,x,y)=>el('g',{transform:`translate(${x} ${y}) scale(${S})`},body);
+const tag=(x,y,label,light=false)=>text(x,y,label,'repere',light?{style:'fill:white'}:{});
+const status=(v,s)=>`${fmt(v)} ${s}`;
+const stamp=v=>g.meta.statuts[v]?v:'E';
+const vs=volumes(),w=g.roues,m=g.module_avant,f=g.flancs;
+const xz=p=>p.map(([x,z])=>[x,-z]);
+const projectXY=v=>rect(v.x[0],-v.y[1],span(v.x),span(v.y),v.rep,{fill:v.color??C[v.rep]});
+const projectYZ=v=>rect(v.y[0],-v.z[1],span(v.y),span(v.z),v.rep,{fill:v.color??C[v.rep]});
+function profileXZ(v,extra={}) {
+  return el('path',{d:[v.p,...(v.holes??[])].map(p=>pathD(xz(p))).join(' '),class:'contour',fill:v.color??C[v.rep],'fill-rule':'evenodd',...extra});
+}
+const defs=`<defs>
+  <pattern id="hachures08" patternUnits="userSpaceOnUse" width="${2/S}" height="${2/S}" patternTransform="rotate(45)"><rect width="${2/S}" height="${2/S}" fill="#fff8f6"/><line x1="0" y1="0" x2="0" y2="${2/S}" stroke="#c0392b" stroke-width="${.25/S}"/></pattern>
+  <marker id="fleche" markerUnits="userSpaceOnUse" markerWidth="${2/S}" markerHeight="${1.6/S}" refX="0" refY="0" viewBox="-2 -0.8 2 1.6" orient="auto-start-reverse"><path d="M0 0 L-2 -0.65 L-2 0.65 Z" fill="#293440"/></marker>
+  <clipPath id="masque-flanc"><path d="${pathD(xz(f.profil_xz))}"/></clipPath>
+  <style>
+    text{font-family:Inter,'DejaVu Sans',Arial,sans-serif;fill:#23303e}
+    .contour{stroke:#293440;stroke-width:${.5/S};stroke-linejoin:round;stroke-linecap:round}
+    .fin,.rappel{stroke:#546270;stroke-width:${.25/S};fill:none}
+    .rappel{stroke:#7c8790;stroke-width:${.18/S}}
+    .axe{stroke:#637584;stroke-width:${.18/S};stroke-dasharray:${[5,1,1,1].map(x=>x/S).join(' ')};fill:none}

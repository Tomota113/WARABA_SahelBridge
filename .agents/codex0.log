+  }
+  b+=profileXZ(vs.find(v=>v.id==='pod-D'))+profileXZ(vs.find(v=>v.id==='fourche-D'));
+  b+=profileXZ(vs.find(v=>v.id==='sectionnement'),{fill:'none',class:'fantome'});

+    moduleCapotReel:Math.hypot(m.axe_x-g.capot.x[1],m.axe_z-g.capot.z[1])-m.rayon,
+    moduleSol:m.axe_z-m.rayon,
+    batterieMoteur:t.moteurs.x-t.moteurs.diametre/2-g.batterie.x[1],

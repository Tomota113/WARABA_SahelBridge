+board+=el('path',{d:'M285 277 V292 M335 277 V292 M378 277 V292',fill:'none',stroke:'#293440','stroke-width':.25});
+board+=text(289,283,`Date : ${date}`,'papier')+text(289,288,`Révision : ${g.meta.revision}`,'papier');

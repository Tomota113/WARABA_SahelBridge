+  if(!dimensions)return b;
+  b+=dv(-g.enveloppe.h,0,g.enveloppe.L+21,m.axe_x,g.enveloppe.L,`${status(g.enveloppe.h,m.statut)} · 08`);
+  const topArceau=Math.max(...g.arceaux.profil_xz.map(p=>p[1]));

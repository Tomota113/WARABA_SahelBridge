+    line(x2,r2+Math.sign(y-r2)/S,x2,y+Math.sign(y-r2)*1.2/S,'rappel')+
+    line(x1,y,x2,y,'fin',{'marker-start':'url(#fleche)','marker-end':'url(#fleche)'})+
+    text(mid([x1,x2]),y-2/S,label,'cote');
+}
+function dv(y1,y2,x,r1,r2,label) {

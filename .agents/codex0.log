+const xz=p=>p.map(([x,z])=>[x,-z]);
+const projectXY=v=>rect(v.x[0],-v.y[1],span(v.x),span(v.y),v.rep,{fill:v.color??C[v.rep]});
+const projectYZ=v=>rect(v.y[0],-v.z[1],span(v.y),span(v.z),v.rep,{fill:v.color??C[v.rep]});
+function profileXZ(v,extra={}) {
+  return el('path',{d:[v.p,...(v.holes??[])].map(p=>pathD(xz(p))).join(' '),class:'contour',fill:v.color??C[v.rep],'fill-rule':'evenodd',...extra});
+}
+const defs=`<defs>
+  <pattern id="hachures08" patternUnits="userSpaceOnUse" width="${2/S}" height="${2/S}" patternTransform="rotate(45)"><rect width="${2/S}" height="${2/S}" fill="#fff8f6"/><line x1="0" y1="0" x2="0" y2="${2/S}" stroke="#c0392b" stroke-width="${.25/S}"/></pattern>

+board+=text(10,13,`${g.meta.nom} / PLANS ${g.meta.revision}`,'entete')+note(210,12,`${g.meta.equipe} · ${g.meta.competition}`);
+board+=el('path',{d:'M5 18 H415 M205 18 V250 M5 174 H205 M205 137 H415 M205 174 H415 M5 250 H415 M5 277 H415',fill:'none',stroke:'#a4afb9','stroke-width':.18});
+board+=title(10,25,'A / DESSUS · capot retiré')+group(top,27,92);
+board+=title(210,25,'D / ENSEMBLE · capot retiré')+group(axon,233,65);

                const outerRail = new THREE.Mesh(outerGeo, blackPlateMat);
                outerRail.position.set(0, 0, (side > 0 ? zOuter - 2.5 : zOuter - 2.5));
                outerRail.castShadow = true;
                subGroups['wheelguards'].add(outerRail);

                // 3 Stries blanches inclinées signature Hotline sur le flanc extérieur (Photos 1, 3, 4)
                const whiteStripeMat = new THREE.MeshBasicMaterial({ color: 0xffffff });
                for (let s = 0; s < 3; s++) {
